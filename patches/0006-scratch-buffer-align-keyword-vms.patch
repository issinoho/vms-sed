Subject: scratch_buffer: on OpenVMS, avoid the member name __align

__align is a keyword in VSI C (a storage-class modifier), so the declaration
failed with %CC-E-DECLARATOR.  The member is never referenced by name.

--- a/lib/malloc/scratch_buffer.h	2026-10-03 16:25:11.147422313 +0100
+++ b/lib/malloc/scratch_buffer.h	2026-10-03 16:25:11.167464828 +0100
@@ -66,7 +66,12 @@
 struct scratch_buffer {
   void *data;    /* Pointer to the beginning of the scratch area.  */
   size_t length; /* Allocated space at the data pointer, in bytes.  */
+#ifdef __VMS
+  /* __align is a keyword in VSI C.  */
+  union { max_align_t __align_; char __c[1024]; } __space;
+#else
   union { max_align_t __align; char __c[1024]; } __space;
+#endif
 };
 
 /* Initializes *BUFFER so that BUFFER->data points to BUFFER->__space
